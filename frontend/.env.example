# GIRIRAKSHAK AI — Frontend Configuration
VITE_API_BASE_URL=/api

# Optional: MapTiler API Key for enhanced cartography (Streets-v2, Outdoor-v2)
# Get a free key at: https://www.maptiler.com/
# If left blank or unset, the map automatically uses free OpenStreetMap tiles with no API key required.
VITE_MAPTILER_API_KEY=

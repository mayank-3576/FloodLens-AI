# FloodLens AI — Environment Configuration Example

# Backend Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Initial Admin Credentials
ADMIN_INITIAL_PASSWORD=Admin@12345
SESSION_EXPIRY_DAYS=7

# Optional External Meteorological & Hydrological API Keys
# When left blank, system operates seamlessly on verified demo records and CWC telemetry baseline
IMD_AWS_API_KEY=
CWC_HYDROLOGY_API_KEY=
OPEN_METEO_API_URL=https://flood-api.open-meteo.com/v1/flood

# Optional Notification Dispatch Providers (In-App notifications are active by default)
# SMTP / Twilio for SMS and email dispatch
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional AI LLM Integrations (Leave blank to use the built-in grounded rule-based RAG assistant)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database Settings
DATABASE_PATH=data/girirakshak.db

# Frontend Settings (Optional overrides for Vite)
VITE_API_BASE_URL=/api

# Optional MapTiler API Key for enhanced map tiles (Streets-v2, Outdoor-v2)
# Obtain a free key at: https://www.maptiler.com/
# Default: Falls back to free OpenStreetMap tiles with no API key required.
VITE_MAPTILER_API_KEY=
